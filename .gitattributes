# Line endings are LF in the repository AND in every working tree, on every OS.
# Without this, a Windows checkout with core.autocrlf converts the tree to CRLF and the
# Prettier format gate (endOfLine: lf) fails on files nobody edited.
* text=auto eol=lf

# Binaries, never converted.
*.png binary
*.webp binary
*.avif binary
*.jpg binary
*.jpeg binary
*.mp4 binary
*.webm binary
*.blend binary
*.woff2 binary
