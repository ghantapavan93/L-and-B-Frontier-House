# L&B Frontier House — runtime environment
#
# Copy to .env.local for development. On Vercel, set these in the project's Environment
# Variables for Production and Preview. Nothing here is a secret except the first line.

# REQUIRED in any deployed environment. Signs the buyer session cookie. Without it,
# every request that touches a session throws "LB_SESSION_SECRET is required in
# production" (src/auth/session.ts). Generate one:  openssl rand -base64 32
LB_SESSION_SECRET=

# The public origin, used to build absolute URLs in the sitemap (src/app/sitemap.ts).
# Defaults to http://localhost:3000, which is wrong everywhere but a laptop.
LB_SITE_URL=https://your-project.vercel.app

# The cinematic layer. Defaults ON when unset; set to 0 for the Phase 1 flag-off build
# (structural test 07 boots that variant in its own dist).
# NEXT_PUBLIC_ENABLE_FRONTIER_EXPERIENCE=1

# NEVER set in a deployed environment. Lets a production build fall back to the
# development signing key; exists only for local production-mode smoke tests.
# LB_ALLOW_DEV_SECRET=1

# Test builds only (npm run build:pinned). Pins the date the promo bar, market line and
# drop line are rendered against, so visual baselines do not expire by calendar. Leave
# unset for real deploys: public pages are static, so they render the calendar as of the
# build — redeploy when a programming window opens or closes.
# LB_RENDER_DATE=2026-09-11
